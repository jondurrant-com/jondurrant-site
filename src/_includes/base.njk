<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="author" content="{{ site.name }}">
  <meta name="theme-color" content="#08080b">
  {%- set canonical = site.url + page.url %}
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- else %}
  <link rel="canonical" href="{{ canonical }}">
  {%- endif %}

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">

  <!-- Open Graph / social link previews -->
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:title" content="{{ socialTitle or title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ site.url }}{{ site.image }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Dr Jon Durrant, embedded systems engineer and maker">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ socialTitle or title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ site.url }}{{ site.image }}">

  {%- for key, href in site.profiles %}
  <link rel="me" href="{{ href }}">
  {%- endfor %}

  <link rel="stylesheet" href="/css/style.css">
  {%- if schema %}{% include schema %}{% endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {{ content | safe }}
</body>
</html>
